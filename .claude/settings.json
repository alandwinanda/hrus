{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run pytest *)",
      "Bash(pytest *)",
      "Bash(uv run ruff *)",
      "Bash(ruff *)",
      "Bash(uvx ruff *)",
      "Bash(npm run *)",
      "Bash(npm --prefix frontend run *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_protected_files.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_file.py\"",
            "timeout": 60,
            "statusMessage": "Format file..."
          }
        ]
      }
    ]
  }
}
