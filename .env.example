# Salin ke .env (otomatis lewat `make up`). Jangan commit .env.

# --- Umum ---
APP_ENV=development             # development | test | production
DEPLOYMENT_MODE=saas            # saas | dedicated
AI_ENABLED=false                # false = mode ERP penuh tanpa AI
LOG_LEVEL=INFO

# --- PostgreSQL (dipakai docker compose) ---
# POSTGRES_USER = owner/superuser, hanya untuk migrasi dan CLI admin.
POSTGRES_USER=hrus
POSTGRES_PASSWORD=hrus_dev_password   # ganti untuk server selain laptop dev
POSTGRES_DB=hrus
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=8080

# User DB aplikasi (non-superuser, tunduk RLS). Dibuat oleh `make migrate`.
APP_DB_USER=hrus_app_user
APP_DB_PASSWORD=hrus_app_dev_password  # ganti untuk server selain laptop dev

# --- Auth ---
# Minimal 32 karakter. Nilai berawalan "dev-only" ditolak saat APP_ENV=production.
# Buat yang baru: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-ganti-secret-ini-sebelum-deploy-ke-server
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false             # wajib true di production (HTTPS)

# --- URL untuk jalan di luar Docker (uv run, pytest) ---
# Di dalam Docker, nilai ini ditimpa docker-compose.yml.
DATABASE_URL=postgresql+psycopg://hrus_app_user:hrus_app_dev_password@localhost:5432/hrus
MIGRATION_DATABASE_URL=postgresql+psycopg://hrus:hrus_dev_password@localhost:5432/hrus
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
# pytest: owner untuk migrasi, user aplikasi test dibuat otomatis oleh conftest.
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://hrus:hrus_dev_password@localhost:5432/hrus_test
TEST_DATABASE_URL=postgresql+psycopg://hrus_app_test:hrus_app_test_password@localhost:5432/hrus_test
TEST_REDIS_URL=redis://localhost:6379/15

# --- AI Gateway ---
LLM_PROVIDER=deepseek           # deepseek | mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
DEEPSEEK_API_KEY=
