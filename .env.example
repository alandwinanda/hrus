# Salin ke .env (otomatis lewat `make up`). Jangan commit .env.

# --- Umum ---
DEPLOYMENT_MODE=saas            # saas | dedicated
AI_ENABLED=false                # false = mode ERP penuh tanpa AI
LOG_LEVEL=INFO

# --- PostgreSQL (dipakai docker compose) ---
POSTGRES_USER=hrus
POSTGRES_PASSWORD=hrus_dev_password   # ganti untuk server selain laptop dev
POSTGRES_DB=hrus
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=8080

# --- URL untuk jalan di luar Docker (uv run, pytest) ---
# Di dalam Docker, nilai ini ditimpa docker-compose.yml.
DATABASE_URL=postgresql+psycopg://hrus:hrus_dev_password@localhost:5432/hrus
MIGRATION_DATABASE_URL=postgresql+psycopg://hrus:hrus_dev_password@localhost:5432/hrus
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
TEST_DATABASE_URL=postgresql+psycopg://hrus:hrus_dev_password@localhost:5432/hrus_test
TEST_REDIS_URL=redis://localhost:6379/15

# --- AI Gateway ---
LLM_PROVIDER=deepseek           # deepseek | mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
DEEPSEEK_API_KEY=
